{% from "components/icon.njk" import icon %}
{% set detail = propertyDetails[propertyKey] %}
{% set properties = sliders[propertyKey].properties %}
{% set facilities = sliders[propertyKey].facilities %}
{% set gallery = detail.gallery %}
{% set destinations = detail.destinations %}
<main class="bg-[#f4f4f3] pt-32 sm:pt-32 lg:pt-34" data-property-name="{{ detail.name }}">
  <section class="px-5 pb-10 sm:px-7 sm:pb-12 lg:px-10 lg:pb-16">
    <div class="mx-auto max-w-7xl">
      <div class="mb-4 flex items-center justify-between">
        <a href="/rumah-dijual" class="interactive-text-icon inline-flex items-center gap-3 text-base font-medium text-neutral-700 transition hover:text-[#0866AE]">{{ icon('solar-arrow-left', 'size-5', 'kembali') }}Kembali</a>
        <button {% if detail.shareId %}id="{{ detail.shareId }}" {% endif %}data-property-share data-share-text="Lihat rumah tipe {{ detail.name }} Grand Ontama." type="button" class="interactive-text-icon inline-flex items-center gap-3 text-base font-medium text-neutral-700 transition hover:text-[#0866AE]">{{ icon('share', 'size-5', 'bagikan') }}Bagikan</button>
      </div>

      <div data-property-gallery class="property-detail-gallery">
        <div class="relative overflow-hidden rounded-2xl bg-neutral-200">
          <img data-gallery-main src="{{ gallery[0].image }}" alt="{{ gallery[0].alt }}" width="1312" height="611" class="h-[320px] w-full object-cover sm:h-[460px] lg:h-[570px]">
          <button data-gallery-prev type="button" aria-label="Foto sebelumnya" class="property-gallery-arrow left-4">{{ icon('chevron-left', 'size-6', 'prev') }}</button>
          <button data-gallery-next type="button" aria-label="Foto berikutnya" class="property-gallery-arrow right-4">{{ icon('chevron-right', 'size-6', 'next') }}</button>
        </div>
        <div class="{{ detail.thumbnailClass }}">
          {% for item in gallery %}
          <button data-gallery-thumb data-gallery-index="{{ loop.index0 }}" type="button" class="property-gallery-thumb{% if loop.first %} is-active{% endif %}">
            <img src="{{ item.image }}" alt="{{ item.alt }}" width="1312" height="611" loading="lazy" class="h-full w-full object-cover">
          </button>
          {% endfor %}
        </div>
      </div>
    </div>
  </section>

  <section class="px-5 pb-10 sm:px-7 sm:pb-12 lg:px-10 lg:pb-6">
    <div class="mx-auto grid max-w-7xl gap-8 lg:grid-cols-[1.35fr_.9fr] lg:items-start">
      <div>
        <p class="flex items-center gap-2 sm:gap-3 text-base sm:text-lg font-medium text-neutral-500">{{ icon('location-fill-alt', 'size-5', 'lokasi-properti') }}<span>Jl. Permata, Curug, Gunung Sindur,<span class="block sm:inline"> Kab. Bogor.</span></span></p>
        <h1 class="home-hero-title mt-7 text-4xl leading-tight tracking-[-.01em] text-neutral-900 sm:text-5xl lg:text-6xl">{% if detail.heading %}{{ detail.heading | safe }}{% else %}Rumah Tipe {{ detail.name }}<br>Grand Ontama{% endif %}</h1>
        <p class="mt-7 max-w-3xl text-base leading-7 text-neutral-500">{{ detail.intro | safe }}</p>

        <div class="property-feature-slider mt-9 pb-8 sm:pb-0 grid gap-4 sm:grid-cols-3">
          <div class="property-feature-card"><span>{{ icon('bed-solid', 'size-8', 'kamar-tidur') }}</span><p>{{ detail.features[0] }}</p></div>
          <div class="property-feature-card"><span>{{ icon('bath-fill', 'size-8', 'kamar-mandi') }}</span><p>{{ detail.features[1] }}</p></div>
          <div class="property-feature-card"><span>{{ icon('ruler', 'size-8', 'luas-bangunan') }}</span><p>{{ detail.features[2] }}</p></div>
        </div>

        <div class="mt-8 space-y-4">
          <div data-property-accordion data-active="false" class="property-info-accordion">
            <h2 class="m-0 text-base font-normal"><button data-property-accordion-button type="button" aria-expanded="false"><span>Spesifikasi Bangunan</span><img data-property-accordion-icon src="/assets/icons/chevron-down.webp" alt="spesifikasi-bangunan" class="local-icon size-5"></button></h2>
            <div data-property-accordion-content class="hidden property-info-content">
              <div><strong>Pondasi &amp; Dinding:</strong> Batu kali / Cakar ayam, Bata ringan (Hebel) plester aci &amp; finish cat</div>
              <div><strong>Lantai:</strong> Utama Melius 60x60, Kamar Mandi Roman 60x60</div>
              <div><strong>Sanitasi &amp; Air:</strong> German Brilliant / American Standard, Sumber air sumur bor, pembuangan biotank</div>
              <div><strong>Pintu, Jendela &amp; Kunci:</strong> Kusen aluminium Incalume / Alexindo, kaca tempered, Smart Door Lock Dekson</div>
              <div><strong>Atap:</strong> Rangka baja ringan dengan penutup bitumen (aspal)</div>
              <div><strong>Daya Listrik:</strong> 2200 Watt</div>
            </div>
          </div>

          <div data-property-accordion data-active="false" class="property-info-accordion">
            <h2 class="m-0 text-base font-normal"><button data-property-accordion-button type="button" aria-expanded="false"><span>Fasilitas Ruang</span><img data-property-accordion-icon src="/assets/icons/chevron-down.webp" alt="fasilitas-ruang" class="local-icon size-5"></button></h2>
            <div data-property-accordion-content class="hidden property-info-content">
              {% for item in detail.rooms %}<div>{{ item }}</div>{% endfor %}
            </div>
          </div>

          <div data-property-accordion data-active="true" class="property-info-accordion">
            <h2 class="m-0 text-base font-normal"><button data-property-accordion-button type="button" aria-expanded="true"><span>Destinasi Dekat Properti</span><img data-property-accordion-icon src="/assets/icons/chevron-down.webp" alt="destinasi-dekat-properti" class="local-icon size-5"></button></h2>
            <div data-property-accordion-content class="property-info-content">
              <div class="destination-filters mb-4 flex gap-3 overflow-x-auto pb-2">
                <button data-destination-filter="transportasi" data-active="true" type="button" class="destination-filter">Transportasi {{ icon('train', 'size-5', 'transportasi') }}</button>
                <button data-destination-filter="sekolah" data-active="false" type="button" class="destination-filter">Sekolah {{ icon('school-outline', 'size-5', 'sekolah') }}</button>
                <button data-destination-filter="pusat-belanja" data-active="false" type="button" class="destination-filter">Pusat Belanja {{ icon('bag', 'size-5', 'pusat-belanja') }}</button>
              </div>
              {% for destination in destinations %}
              <div data-destination-item data-cat="{{ destination.cat }}" class="{% if destination.cat != 'transportasi' %}hidden{% else %}flex{% endif %} destination-row">
                <div><strong>{{ destination.name }}</strong><p><span>{{ icon('car', 'size-4', 'waktu-tempuh') }}{{ destination.time }}</span><span>{{ icon('location-outline', 'size-4', 'jarak') }}{{ destination.distance }}</span></p></div>
                <a href="{{ destination.href }}" target="_blank" rel="noopener noreferrer" aria-label="Buka rute {{ destination.name }}">{{ icon('directions-filled', 'size-5', 'buka-rute') }}</a>
              </div>
              {% endfor %}
            </div>
          </div>

          <div data-property-accordion data-active="false" class="property-info-accordion">
            <h2 class="m-0 text-base font-normal"><button data-property-accordion-button type="button" aria-expanded="false"><span>Harga Termasuk</span><img data-property-accordion-icon src="/assets/icons/chevron-down.webp" alt="harga-termasuk" class="local-icon size-5"></button></h2>
            <div data-property-accordion-content class="hidden property-info-content">
              {% for item in ['IMB (Izin Mendirikan Bangunan)', 'Biaya Notaris untuk PPJB & AJB', 'Biaya Pecah Sertifikat, AJB Balik Nama, dan BPHTB', 'Biaya Penyambutan Listrik', 'Biaya Penyambungan Air Bersih', 'PPN 11%', 'Biaya KPR'] %}<div>{{ item }}</div>{% endfor %}
            </div>
          </div>

          <div data-property-accordion data-active="false" class="property-info-accordion">
            <h2 class="m-0 text-base font-normal"><button data-property-accordion-button type="button" aria-expanded="false"><span>Harga Tidak Termasuk</span><img data-property-accordion-icon src="/assets/icons/chevron-down.webp" alt="harga-tidak-termasuk" class="local-icon size-5"></button></h2>
            <div data-property-accordion-content class="hidden property-info-content">
              {% for item in ['Biaya BPPL (Biaya Pengelolaan Lingkungan)', 'PPnBM dan pajak lainnya di kemudian hari', 'Biaya Administrasi'] %}<div>{{ item }}</div>{% endfor %}
            </div>
          </div>
        </div>
      </div>

      <aside data-property-kpr-card class="rounded-2xl bg-white p-4 sm:p-6 shadow-[0_18px_50px_rgba(31,41,55,.07)] sm:p-7">
        <p data-kpr-start-label class="text-base font-medium text-neutral-600">Harga Mulai</p>
        <p data-kpr-start-price class="mt-2 text-2xl font-semibold text-neutral-900 sm:text-4xl">{{ detail.prices[0] }}</p>
        <p class="mt-8 text-base font-medium text-neutral-700">Estimasi Cicilan KPR / Bulan</p>
        <div data-kpr-options class="mt-4 grid grid-cols-3 gap-3">
          <button type="button" data-kpr-option data-active="true" data-period="15 Tahun" data-payment="{{ detail.prices[1] }}" class="kpr-option"><strong>{{ detail.prices[1] }}</strong><span>15 Tahun</span></button>
          <button type="button" data-kpr-option data-active="false" data-period="20 Tahun" data-payment="{{ detail.prices[2] }}" class="kpr-option"><strong>{{ detail.prices[2] }}</strong><span>20 Tahun</span></button>
          <button type="button" data-kpr-option data-active="false" data-period="25 Tahun" data-payment="{{ detail.prices[3] }}" class="kpr-option"><strong>{{ detail.prices[3] }}</strong><span>25 Tahun</span></button>
        </div>
        <p class="sr-only" aria-live="polite" data-kpr-status>Estimasi cicilan 15 Tahun: {{ detail.prices[1] }} per bulan</p>
        <div data-kpr-price-summary class="mt-6 space-y-3">
          <div class="flex items-center justify-between rounded-xl bg-neutral-50 px-4 py-4"><span class="text-neutral-500">Harga KPR</span><strong>{{ detail.prices[4] }}</strong></div>
          <div class="flex items-center justify-between rounded-xl bg-neutral-50 px-4 py-4"><span class="text-neutral-500">KPR Non PPN</span><strong>{{ detail.prices[5] }}</strong></div>
        </div>
        <div class="mt-7 border-t border-neutral-200 pt-6">
          <a data-kpr-order href="https://wa.me/{{ site.phone }}?text=Halo%20Grand%20Ontama%2C%20saya%20tertarik%20dengan%20rumah%20tipe%20{{ detail.name }}." target="_blank" rel="noopener noreferrer" class="block rounded-full bg-[#0866AE] px-6 py-4 text-center font-medium text-white transition hover:bg-[#0879BD]">Pesan Sekarang</a>
          <a href="/assets/docs/brosur-grand-ontama.pdf" target="_blank" rel="noopener noreferrer" class="mt-3 flex items-center justify-center gap-3 rounded-full bg-neutral-100 px-6 py-4 font-medium text-neutral-700 transition hover:bg-neutral-200">Brosur Grand Ontama {{ icon('download', 'size-5', 'brosur-grand-ontama') }}</a>
          {% if detail.certificate %}
          <a href="{{ detail.certificate }}" target="_blank" rel="noopener noreferrer" class="mt-3 flex items-center justify-center gap-3 rounded-full bg-neutral-100 px-6 py-4 font-medium text-neutral-700 transition hover:bg-neutral-200">Sertifikat Unit {{ detail.name }} {{ icon('download', 'size-5 brightness-0 opacity-75', 'sertifikat unit ' ~ (detail.name | lower)) }}</a>
          {% endif %}
        </div>
        <div class="mt-7 space-y-3 border-t border-neutral-200 pt-6">
          {% for benefit in detail.benefits %}
          <div class="flex gap-4 rounded-xl bg-neutral-50 p-4"><span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-[#e4f4fd] text-[#0879bd]">{{ icon('verified', 'size-6', benefit[0] | lower | replace(' ', '-')) }}</span><div><strong class="font-medium">{{ benefit[0] }}</strong><p class="mt-1 text-sm text-neutral-500">{{ benefit[1] }}</p></div></div>
          {% endfor %}
        </div>
      </aside>
    </div>
  </section>

  <section class="px-5 pb-10 pt-10 sm:px-7 sm:pb-12 lg:px-10 lg:pb-6 lg:pt-24">
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-6 lg:grid-cols-[1.15fr_.85fr] lg:items-center">
        <h2 class="home-hero-title text-4xl leading-tight tracking-[-.01em] text-neutral-900 sm:text-5xl lg:text-6xl">{{ detail.sections[0].heading | safe }}</h2>
        <p class="max-w-xl text-base leading-7 text-neutral-500">{{ detail.sections[0].description | safe }}</p>
      </div>
      {% include "components/facility-slider.njk" %}
    </div>
  </section>

  <section class="px-5 pt-10 sm:px-7 lg:px-10 lg:pt-24 {% if detail.faqs %}pb-10 sm:pb-12 lg:pb-6{% else %}pb-16 sm:pb-20 lg:pb-24{% endif %}">
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-6 lg:grid-cols-[1.2fr_.8fr] lg:items-center">
        <h2 class="home-hero-title text-4xl leading-tight tracking-[-.01em] text-neutral-900 sm:text-5xl lg:text-6xl">{{ detail.sections[1].heading | safe }}</h2>
        <p class="max-w-xl text-base leading-7 text-neutral-500">{{ detail.sections[1].description | safe }}</p>
      </div>
      {% include "components/property-slider.njk" %}
    </div>
  </section>

  {% if detail.faqs %}
    {% include "components/property-faq.njk" %}
  {% endif %}
</main>
