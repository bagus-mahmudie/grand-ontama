<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }}</title>
    <meta name="description" content="{{ description }}">
    {% if keywords %}<meta name="keywords" content="{{ keywords }}">{% endif %}
    {% if noindex %}<meta name="robots" content="noindex,follow">{% endif %}
    <meta name="google-site-verification" content="1WpDnTxeKLf0I9umcwyFm5ZE-RvkYBi50lPkTuCQvQg">
    <link rel="canonical" href="{{ canonical }}">

    <meta property="og:locale" content="{{ site.locale }}">
    <meta property="og:type" content="{{ ogType or 'website' }}">
    <meta property="og:url" content="{{ canonical }}">
    <meta property="og:title" content="{{ ogTitle or title }}">
    <meta property="og:description" content="{{ description }}">
    <meta property="og:image" content="{{ ogImage }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ ogTitle or title }}">
    <meta name="twitter:description" content="{{ description }}">
    <meta name="twitter:image" content="{{ ogImage }}">
    {% if ogType == "article" %}<meta property="article:published_time" content="{{ publishedAt }}"><meta property="article:modified_time" content="{{ updatedAt or publishedAt }}">{% endif %}

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": ["Organization", "RealEstateAgent"],
            "@id": "{{ site.url }}/#organization",
            "name": {{ site.name | json | safe }},
            "legalName": {{ site.legalName | json | safe }},
            "url": {{ site.url | json | safe }},
            "logo": {{ (site.url + '/assets/img/grand-ontama-logo.webp') | json | safe }},
            "telephone": {{ site.phoneDisplay | json | safe }},
            "email": {{ site.email | json | safe }},
            "address": {
              "@type": "PostalAddress",
              "streetAddress": {{ site.address | json | safe }},
              "addressLocality": "Bogor",
              "addressRegion": "Jawa Barat",
              "addressCountry": "ID"
            },
            "sameAs": [
              "https://www.instagram.com/grandontama",
              "https://www.tiktok.com/@grandontama",
              "https://www.youtube.com/@grandontama"
            ]
          },
          {
            "@type": "WebSite",
            "@id": "{{ site.url }}/#website",
            "url": {{ site.url | json | safe }},
            "name": {{ site.name | json | safe }},
            "inLanguage": "id-ID",
            "publisher": { "@id": "{{ site.url }}/#organization" }
          }{% if ogType == "article" %},
          {
            "@type": "Article",
            "@id": {{ canonical | json | safe }},
            "mainEntityOfPage": { "@id": {{ canonical | json | safe }} },
            "headline": {{ title | json | safe }},
            "description": {{ description | json | safe }},
            "image": {{ ogImage | json | safe }},
            "datePublished": {{ publishedAt | json | safe }},
            "dateModified": {{ (updatedAt or publishedAt) | json | safe }},
            "inLanguage": "id-ID",
            "author": { "@id": "{{ site.url }}/#organization" },
            "publisher": { "@id": "{{ site.url }}/#organization" }
          }{% endif %}{% if breadcrumbParent %},
          {
            "@type": "BreadcrumbList",
            "@id": {{ (canonical + '#breadcrumb') | json | safe }},
            "itemListElement": [
              {
                "@type": "ListItem",
                "position": 1,
                "name": "Beranda",
                "item": {{ site.url | json | safe }}
              },
              {
                "@type": "ListItem",
                "position": 2,
                "name": {{ breadcrumbParent | json | safe }},
                "item": {{ (site.url + breadcrumbParentUrl) | json | safe }}
              },
              {
                "@type": "ListItem",
                "position": 3,
                "name": {{ (ogTitle or title) | json | safe }},
                "item": {{ canonical | json | safe }}
              }
            ]
          }{% endif %}{% if propertySchema %},
          {
            "@type": "SingleFamilyResidence",
            "@id": {{ (canonical + '#residence') | json | safe }},
            "name": {{ propertySchema.name | json | safe }},
            "description": {{ description | json | safe }},
            "url": {{ canonical | json | safe }},
            "image": {{ ogImage | json | safe }},
            "numberOfBedrooms": {{ propertySchema.bedrooms | json | safe }},
            "numberOfBathroomsTotal": {{ propertySchema.bathrooms | json | safe }},
            "floorSize": {
              "@type": "QuantitativeValue",
              "value": {{ propertySchema.floorArea | json | safe }},
              "unitCode": "MTK"
            },
            "address": {
              "@type": "PostalAddress",
              "streetAddress": {{ site.address | json | safe }},
              "addressLocality": "Bogor",
              "addressRegion": "Jawa Barat",
              "addressCountry": "ID"
            },
            "offers": {
              "@type": "Offer",
              "price": {{ propertySchema.price | json | safe }},
              "priceCurrency": "IDR",
              "availability": "https://schema.org/InStock",
              "url": {{ canonical | json | safe }},
              "seller": { "@id": "{{ site.url }}/#organization" }
            }
          }{% endif %}
        ]
      }
    </script>

    <link href="/assets/img/favicon.webp" rel="icon">
    <link href="/assets/img/apple-touch-icon.webp" rel="apple-touch-icon">
    <link rel="preload" href="/assets/fonts/lufga/Lufga-Medium.otf" as="font" type="font/otf" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet"></noscript>
    <link rel="stylesheet" href="/assets/css/site.css">

    <script>
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
      window.addEventListener('load', function () {
        var loadTagManager = function () {
          var script = document.createElement('script');
          script.async = true;
          script.src = 'https://www.googletagmanager.com/gtm.js?id={{ site.tagManagerId }}';
          document.head.appendChild(script);
        };
        if ('requestIdleCallback' in window) {
          window.requestIdleCallback(loadTagManager, { timeout: 3000 });
        } else {
          window.setTimeout(loadTagManager, 1200);
        }
      }, { once: true });
    </script>
  </head>
  <body class="bg-white font-sans text-neutral-800" data-page="{{ pageKey }}">
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id={{ site.tagManagerId }}" height="0" width="0" class="hidden"></iframe></noscript>
    {% include "partials/header.njk" %}
    {{ content | safe }}
    {% include "partials/footer.njk" %}
    {% if pageKey != "beranda" and pageKey != "kontak" %}{% include "partials/floating-actions.njk" %}{% endif %}
    {% include "partials/share-modal.njk" %}
    {% if ogType == "article" %}<script id="site-blog-posts" type="application/json">{{ blogData.posts | json | safe }}</script>{% endif %}
    <script src="/assets/generated/responsive-images.js" defer></script>
    <script src="/assets/js/app.js" defer></script>
  </body>
</html>
