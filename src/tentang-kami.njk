{% from "components/icon.njk" import icon %}
<main class="bg-[#f4f4f3] pt-30 sm:pt-36 lg:pt-44">
  <section class="px-5 pb-10 sm:px-7 sm:pb-12 lg:px-10 lg:pb-6">
    <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[1.05fr_.95fr] lg:items-stretch lg:gap-16">
      <div class="flex flex-col justify-center">
        <h1 class="home-hero-title text-4xl leading-[1.18] tracking-[-.01em] text-neutral-900 sm:text-5xl lg:text-6xl">Grand Ontama,<br>Hunian Berkualitas<br>untuk Keluarga</h1>
        <div class="mt-5 sm:mt-8 max-w-xl space-y-6 text-base leading-7 text-neutral-500">
          <p>Grand Ontama merupakan hunian yang dikembangkan oleh <strong class="font-semibold text-neutral-700">PT OMAH LENTERA INOVASI</strong>, sebuah developer properti yang menghadirkan pilihan rumah untuk kebutuhan keluarga.</p>
          <p>Dengan memperhatikan kualitas hunian, kenyamanan, dan kelengkapan informasi properti, Grand Ontama membantu calon pemilik rumah menemukan hunian yang sesuai dengan kebutuhan dan rencana masa depan keluarga.</p>
        </div>

        <div class="mt-16 grid grid-cols-3 gap-4 text-center sm:max-w-xl sm:gap-8">
          <div><strong class="block text-3xl font-semibold text-neutral-900 sm:text-5xl">24/7</strong><span class="mt-2 block text-sm leading-6 text-neutral-500 sm:text-base">Layanan Konsultasi</span></div>
          <div><strong class="block text-3xl font-semibold text-neutral-900 sm:text-5xl"><span data-counter data-counter-end="50">0</span>+</strong><span class="mt-2 block text-sm leading-6 text-neutral-500 sm:text-base">Customer Dilayani</span></div>
          <div><strong class="block text-3xl font-semibold text-neutral-900 sm:text-5xl"><span data-counter data-counter-end="100">0</span>%</strong><span class="mt-2 block text-sm leading-6 text-neutral-500 sm:text-base">Pendampingan</span></div>
        </div>
      </div>

      <div class="relative min-h-145 overflow-hidden rounded-2xl bg-neutral-200 shadow-[0_20px_55px_rgba(31,41,55,.10)]">
        <img src="/assets/img/pages/tentang-kami/tentang-grand-ontama.webp" alt="tentang-grand-ontama" width="768" height="768" class="absolute inset-0 h-full w-full object-cover" fetchpriority="high">
        <article class="absolute inset-x-4 bottom-4 rounded-2xl bg-white p-5 shadow-[0_16px_40px_rgba(31,41,55,.16)] sm:p-6">
          <div class="flex gap-1 text-[#ffb000]" aria-label="Rating 5 dari 5">{{ icon('star-fill', 'size-5', 'rating-bintang') }}{{ icon('star-fill', 'size-5', 'rating-bintang') }}{{ icon('star-fill', 'size-5', 'rating-bintang') }}{{ icon('star-fill', 'size-5', 'rating-bintang') }}{{ icon('star-fill', 'size-5', 'rating-bintang') }}</div>
          <p class="mt-4 text-base leading-7 text-neutral-500">Rumahnya 2,5 lantai dan lokasinya strategis banget. Lingkungannya asri dan bebas banjir. Fasilitasnya banyak, ada lapangan padel juga.</p>
          <div class="mt-5 flex items-center gap-4">
            <img src="/assets/img/icon/iswah-yudi.webp" alt="Iswah Yudi" width="48" height="48" class="h-12 w-12 rounded-full object-cover">
            <div><p class="font-semibold text-neutral-900">Iswah Yudi</p><p class="text-sm text-neutral-400">Local Guide</p></div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="px-5 pb-10 pt-10 sm:px-7 sm:pb-12 lg:px-10 lg:pb-6 lg:pt-24">
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-5 lg:grid-cols-[1.2fr_.8fr] lg:items-center">
        <h2 class="home-hero-title text-4xl leading-tight tracking-[-.01em] text-neutral-900 sm:text-5xl lg:text-6xl">Desain Interior Rumah<br>Grand Ontama</h2>
        <p class="max-w-xl text-base leading-7 text-neutral-500">Setiap ruang Grand Ontama dirancang fungsional dan nyaman, mulai dari kamar tidur, ruang makan, ruang keluarga, hingga taman untuk kebutuhan keluarga modern.</p>
      </div>

      {% set interiors = [
        { title: 'Ruang Makan', description: 'Area makan nyaman untuk menikmati waktu bersama keluarga setiap hari.', image: '/assets/img/pages/tentang-kami/profil-grand-ontama.png', alt: 'profil-grand-ontama', className: 'lg:col-span-2' },
        { title: 'Ruang Keluarga', description: 'Ruang hangat untuk berkumpul dan berbagi cerita bersama.', image: '/assets/img/pages/tentang-kami/desain-interior-grand-ontama.png', alt: 'desain-interior-grand-ontama', className: '' },
        { title: 'Kamar Tidur', description: 'Ruang pribadi nyaman untuk beristirahat setelah aktivitas.', image: '/assets/img/pages/tentang-kami/Informasi-grand-ontama.png', alt: 'Informasi-grand-ontama', className: '' },
        { title: 'Balkon Rumah', description: 'Area terbuka untuk menikmati udara segar dan suasana lingkungan sekitar.', image: '/assets/img/pages/tentang-kami/tentang-perumahan-gunung-sindur.png', alt: 'tentang-perumahan-gunung-sindur', className: '' },
        { title: 'Sudut Hijau Rumah', description: 'Tanaman menghadirkan suasana segar dan alami di dalam rumah.', image: '/assets/img/pages/tentang-kami/lokasi-grand-ontama.png', alt: 'lokasi-grand-ontama', className: '' }
      ] %}
      <div class="mt-12 grid gap-5 lg:grid-cols-3">
        {% for interior in interiors %}
        <article class="group relative h-80 overflow-hidden rounded-2xl bg-neutral-300 {{ interior.className }} {% if loop.index <= 2 %}lg:h-105{% else %}lg:h-95{% endif %}">
          <img src="{{ interior.image }}" alt="{{ interior.alt }}" loading="lazy" draggable="false" class="h-full w-full object-cover transition duration-500 group-hover:scale-105">
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 p-5 text-white sm:p-6">
            <h3 class="text-xl font-medium">{{ interior.title }}</h3>
            <p class="mt-2 text-base leading-7 text-white/80 {% if interior.title == 'Ruang Makan' %}max-w-sm{% endif %}">{{ interior.description }}</p>
          </div>
        </article>
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="px-5 pb-10 pt-10 sm:px-7 sm:pb-12 lg:px-10 lg:pb-6 lg:pt-24">
    <div class="mx-auto max-w-7xl">
      <div class="text-center">
        <h2 class="home-hero-title mx-auto max-w-4xl text-4xl leading-tight tracking-[-.01em] text-neutral-900 sm:text-5xl lg:text-6xl">Mengapa harus memilih<br>properti dari Grand Ontama?</h2>
        <p class="mx-auto mt-6 max-w-3xl text-base leading-7 text-neutral-500">Grand Ontama menghadirkan hunian nyaman, pilihan tipe beragam, desain fungsional, serta lingkungan yang mendukung kebutuhan keluarga dan rencana masa depan.</p>
      </div>

      {% set advantages = [
        { icon: 'european-house', title: 'Gaya Eropa', text: 'Hunian bergaya Eropa dengan fasad elegan, klasik, dan berkarakter.' },
        { icon: 'home-bold', title: 'Tiga Tipe', text: 'Grand Ontama menawarkan pilihan sesuai kebutuhan keluarga Anda.' },
        { icon: 'sparkles-fill', title: 'Fasilitas Lengkap', text: 'Fasilitas lengkap meliputi clubhouse, taman, tenis, padel, dan keamanan.' },
        { icon: 'shield-filled', title: 'Keamanan Terjaga', text: 'Keamanan kawasan didukung one gate system, CCTV, dan security 24/7.' },
        { icon: 'ai-portrait-spark', title: 'Legalitas Jelas', text: 'Legalitas properti tersedia untuk memberikan ketenangan Anda.' },
        { icon: 'location-fill', title: 'Lokasi Strategis', text: 'Lokasi strategis dekat rumah sakit, universitas, pusat belanja, dan stasiun.' }
      ] %}
      <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {% for item in advantages %}
        <article class="rounded-2xl bg-white p-6 shadow-[0_15px_40px_rgba(31,41,55,.06)] sm:p-7">
          <span class="grid h-20 w-20 place-items-center rounded-full bg-neutral-100 text-[#0879bd]">{{ icon(item.icon, 'size-10', item.title | lower | replace(' ', '-')) }}</span>
          <h3 class="mt-6 text-2xl font-medium text-neutral-900">{{ item.title }}</h3>
          <p class="mt-3 text-base leading-7 text-neutral-500">{{ item.text }}</p>
        </article>
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="px-5 pb-10 pt-10 sm:px-7 sm:pb-12 lg:px-10 lg:pb-6 lg:pt-24">
    <div class="mx-auto max-w-7xl">
      <div class="grid gap-5 lg:grid-cols-[1.2fr_.8fr] lg:items-center">
        <h2 class="home-hero-title text-4xl leading-tight tracking-[-.01em] text-neutral-900 sm:text-5xl lg:text-6xl">Konsultasikan Rumah<br>Anda Sekarang</h2>
        <p class="max-w-xl text-base leading-7 text-neutral-500">Dapatkan informasi Grand Ontama mengenai tipe rumah, harga, fasilitas, lokasi, dan proses pembelian langsung dari tim kami.</p>
      </div>
      <div class="mt-12 grid gap-6 lg:grid-cols-2 lg:items-stretch">
        {% include "components/location-map.njk" %}
        {% include "components/whatsapp-question-form.njk" %}
      </div>
    </div>
  </section>


  <section class="px-5 pb-10 pt-10 sm:px-7 sm:pb-20 lg:px-10 lg:pb-24 lg:pt-24">
    <div class="mx-auto max-w-5xl">
      <div class="text-center">
        <h2 class="home-hero-title text-4xl leading-tight tracking-[-.01em] text-neutral-900 sm:text-5xl lg:text-6xl">Frequently Asked Questions</h2>
        <p class="mx-auto mt-5 max-w-3xl text-base leading-7 text-neutral-500">Temukan jawaban seputar Grand Ontama, mulai dari tipe rumah, lokasi, fasilitas, legalitas, harga, hingga proses pembelian hunian.</p>
      </div>

      {% set faqs = [
        { question: 'Bagaimana kepastian legalitas dan Izin Mendirikan Bangunan (PBG/IMB) di Grand Ontama?', answer: 'Seluruh unit dan tata ruang di Grand Ontama dipastikan aman secara hukum. Kami telah mengantongi Izin Mendirikan Bangunan (PBG/IMB) yang sah dari pemerintah daerah serta kelengkapan dokumen landasan hukum seperti Sertifikat Hak Milik (SHM) pecah per unit. Anda dapat melakukan transaksi dengan tenang tanpa khawatir masalah sengketa atau perizinan.' },
        { question: 'Mengapa harus memilih proyek hunian dari PT OMAH LENTERA INOVASI?', answer: 'Sebagai developer properti berdedikasi, PT OMAH LENTERA INOVASI tidak hanya menjual rumah, tetapi menciptakan ekosistem hunian modern. Kami menghadirkan kombinasi desain bangunan presisi seperti arsitektur modern gaya Eropa dan mezzanine, lokasi strategis di Gunung Sindur, kualitas material standar tinggi, serta kemudahan proses pembiayaan KPR.' },
        { question: 'Apakah PT OMAH LENTERA INOVASI bekerja sama dengan bank untuk pembelian via KPR?', answer: 'Ya, sebagai developer properti resmi, kami bekerja sama dengan berbagai bank penyedia KPR, baik bank syariah maupun konvensional. Kelengkapan berkas seperti Izin Mendirikan Bangunan (PBG/IMB) dan SHM yang sudah jelas memudahkan calon pembeli dalam proses pengajuan KPR hingga akad kredit.' },
        { question: 'Bagaimana cara berkonsultasi atau mengunjungi kantor resmi PT OMAH LENTERA INOVASI?', answer: 'Anda dapat menghubungi tim Marketing Gallery PT OMAH LENTERA INOVASI melalui tombol WhatsApp resmi di situs ini, atau datang langsung ke lokasi marketing office kami di proyek Grand Ontama, Gunung Sindur. Tim profesional kami siap membantu Anda dari konsultasi unit, pemanduan survei lokasi, hingga pendampingan KPR.' }
      ] %}
      <div class="mt-12 space-y-5">
        {% for faq in faqs %}
        <article data-faq-item data-active="{% if loop.index == 2 %}true{% else %}false{% endif %}" class="rounded-2xl bg-white p-5 shadow-[0_12px_35px_rgba(31,41,55,.055)] transition sm:p-6">
          <h3 class="m-0 text-base font-normal"><button data-faq-button type="button" aria-expanded="{% if loop.index == 2 %}true{% else %}false{% endif %}" class="flex w-full cursor-pointer items-center justify-between gap-5 text-left">
            <span class="text-lg font-medium leading-7 text-content-title">{{ faq.question }}</span>
            <img data-faq-icon data-icon="{% if loop.index == 2 %}minus{% else %}plus{% endif %}" src="/assets/icons/{% if loop.index == 2 %}minus{% else %}plus{% endif %}.webp" alt="{% if loop.index == 2 %}tutup-pertanyaan{% else %}buka-pertanyaan{% endif %}" class="local-icon size-6 {% if loop.index == 2 %}icon-white{% else %}icon-brand{% endif %} shrink-0">
          </button></h3>
          <div data-faq-content class="{% if loop.index != 2 %}hidden{% endif %}">
            <p class="mt-5 max-w-4xl text-base leading-7 {% if loop.index == 2 %}text-white/90{% else %}text-content-grey{% endif %}">{{ faq.answer }}</p>
          </div>
        </article>
        {% endfor %}
      </div>
    </div>
  </section>
</main>
