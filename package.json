{
  "name": "grand-ontama-redesign",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:css": "tailwindcss -i ./src/assets/css/input.css -o ./src/assets/css/site.css --watch",
    "dev:site": "eleventy --serve",
    "dev": "npm-run-all --parallel dev:css dev:site",
    "build:css": "tailwindcss -i ./src/assets/css/input.css -o ./src/assets/css/site.css --minify",
    "build:site": "eleventy",
    "build": "npm run build:css && npm run build:site",
    "check": "node ./scripts/check-build.mjs",
    "package:cpanel": "powershell -ExecutionPolicy Bypass -File ./deploy/build-cpanel.ps1"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@tailwindcss/cli": "^4.3.3",
    "gray-matter": "^4.0.3",
    "npm-run-all": "^4.1.5",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3"
  }
}
